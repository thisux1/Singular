# Singular — Environment Variables
# Copy to .env and fill in your values. This is the SINGLE source of truth —
# backend/.env.example is a pointer to this file. backend/.env (if present)
# takes precedence over this file for the backend process.
#
# For local/dev mode: defaults work out of the box with docker-compose
# (postgres :5432, redis :6379). AUTH_DISABLED=true skips OAuth entirely.

# ---------- Core Infrastructure ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/singular
REDIS_URL=redis://localhost:6379
PORT=3001

# ---------- Auth (Better Auth + Google OAuth) ----------
# Dev/self-host single-user: leave AUTH_DISABLED=true — no Google setup needed.
AUTH_DISABLED=true
# Required in real multi-user mode (AUTH_DISABLED=false).
# Generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Public URL of the backend (Better Auth base URL).
BETTER_AUTH_URL=http://localhost:3001
# Frontend URL — used for post-login redirect and trustedOrigins.
FRONTEND_URL=http://localhost:5173
# Comma-separated allowlist of CORS origins (credentials enabled).
CORS_ORIGINS=http://localhost:5190,http://localhost:5173
# Google OAuth — only when AUTH_DISABLED=false.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------- Email (Resend) — verification + password reset ----------
# Without a key, emails are logged to the backend console and email
# verification is skipped (self-host friendly).
# RESEND_API_KEY=
# Sender shown in transactional emails. Use a verified Resend domain in prod.
EMAIL_FROM=Singular <noreply@singular.app>
# Set true to block login until the user verifies their email (requires Resend).
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ---------- Upload / Storage ----------
# Relative paths resolve against backend/ (never process.cwd()).
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
# Optional: GCS bucket for storage in deploy mode (local disk driver used when unset).
# GCS_BUCKET=

# ---------- OCR Provider ----------
# Options: "local" (Ollama, $0) | "api" (Gemini Flash) | "docling" (legacy)
OCR_PROVIDER=local

# --- Local mode (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OCR_MODEL=glm-ocr
OLLAMA_OCR_FALLBACK_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=16384

# --- API mode (Gemini) ---
# GEMINI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here  # alternative

# ---------- Pipeline ----------
# Absolute path OR relative path (resolved against repo root) OR bare binary
# name resolved via PATH. Default: <repoRoot>/.venv/bin/python if it exists,
# else "python3". Existence is validated at worker boot, not API boot.
PIPELINE_PYTHON_BIN=.venv/bin/python
# Relative paths resolve against backend/.
PIPELINE_ENTRYPOINT=../pipeline/main.py
PIPELINE_EXTRACT_MIN_CHARS=180
PIPELINE_GEMINI_MODEL=gemini-2.5-flash
PIPELINE_USE_MOCK_GEMINI=false

# ---------- LLM Classification ----------
CLASSIFICATION_ENABLED=true
CLASSIFICATION_MODEL=gemini-2.5-flash
CLASSIFICATION_BATCH_SIZE=10
CLASSIFICATION_REQUEST_TIMEOUT_MS=30000
CLASSIFICATION_MAX_RETRIES=2
CLASSIFICATION_DAILY_USD_LIMIT=1
CLASSIFICATION_INPUT_USD_PER_1M=0.3
CLASSIFICATION_OUTPUT_USD_PER_1M=2.5

# ---------- Fast-path Parser ----------
PROCESSING_FORCE_FALLBACK=false
# Scale is 0–100 (default 80). Values <= 1 trigger a legacy-scale warning
# and fall back to 80.
FASTPATH_MIN_CONFIDENCE=80
FASTPATH_MIN_QUESTIONS=1
FASTPATH_MIN_QUESTION_CHARS=10

# ---------- Other ----------
# CONTEXT7_API_KEY=your-key-here

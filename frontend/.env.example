# Auth — espelha AUTH_DISABLED do backend (raiz/.env).
# true  → dev single-user: sem login wall, requests sem sessão.
# false → exige sessão Better Auth (login Google).
VITE_AUTH_DISABLED=true

# Base da API de dados (default: http://localhost:3001/api)
# VITE_API_URL=http://localhost:3001/api

# Raiz do backend para o Better Auth client (ele sufixa /api/auth).
# Opcional: derivada de VITE_API_URL removendo o /api final.
# VITE_AUTH_URL=http://localhost:3001
